[Unit]
Description=Auto Stock %i routine
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/auto-stock
EnvironmentFile=/etc/auto-stock/auto-stock.env
Environment=PYTHONIOENCODING=utf-8
UMask=0077
ExecStart=/usr/bin/flock --nonblock /run/lock/auto-stock.lock /home/ubuntu/auto-stock/.venv/bin/python /home/ubuntu/auto-stock/scripts/run_routine.py %i
