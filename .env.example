# ==========================================
# Toss Securities Open API Configuration
# ==========================================
# 토스증권 WTS (설정 > Open API)에서 발급받은 키 입력
TOSS_CLIENT_ID=your_toss_client_id_here
TOSS_CLIENT_SECRET=your_toss_client_secret_here

# 계좌 시퀀스 (Account Sequence, 예: 1000000000)
TOSS_ACCOUNT_SEQ=your_toss_account_seq_here

# API 엔드포인트 (기본값: 실운영 서버)
TOSS_BASE_URL=https://openapi.tossinvest.com
TOSS_WS_URL=wss://openapi-ws.tossinvest.com/ws/v1

# ==========================================
# Infinite Buying Strategy V4.0 Default Parameters
# ==========================================
TARGET_TICKER=SOXL
TARGET_DIVISIONS=40
TARGET_PROFIT_RATE=0.20
LARGE_NUMBER_RATIO=1.12
TOTAL_BUDGET_USD=30000.0

# ==========================================
# Scheduled live-trading safeguards (Linux systemd)
# ==========================================
# 아침 루틴은 항상 Dry-Run입니다. 저녁 실거래를 허용할 때만 true로 설정하세요.
ENABLE_LIVE_TRADING=false
LIVE_BUY_LIMIT_USD=

# ==========================================
# Notification & Alert Settings (Optional)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# Google Sheets account snapshot (Agent 8)
# ==========================================
# 사용 설정 후 서비스 계정 이메일을 대상 스프레드시트에 편집자로 공유하세요.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_GID=22630165
# 서버에 안전하게 저장한 서비스 계정 JSON 파일의 경로 (저장소에 추가하지 마세요)
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=
# 티커와 기존 행을 지정해 목표 비중/수식(G~I)이 다른 종목에 붙지 않도록 합니다.
# 동주(키움) 탭의 현재 보유 종목 행 (계좌 보유 종목이 바뀌면 갱신)
GOOGLE_SHEETS_TICKER_ROWS=NVDU:5,SOXL:6,TQQQ:7
GOOGLE_SHEETS_CASH_ROW=10
